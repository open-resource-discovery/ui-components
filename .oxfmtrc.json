{
  "printWidth": 120,
  "quoteProps": "consistent",
  "bracketSameLine": true,
  "singleQuote": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-*/**",
    "**/.test-dist/**",
    "**/reports/**",
    "**/coverage/**",
    "**/.next/**",
    "**/build/**",
    "**/.docusaurus/**",
    "**/vendor/**",
    "**/generated/**",
    "**/examples/**",
    "**/fixtures/**",
    "**/original-schema/**",
    "**/__snapshots__/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/storybook-static/**",
    "**/.vscode-test/**",
    "**/resources/**",
    "**/test-data/**",
    "**/testdata/**",
    "**/.github/**",
    "**/example/**",
    "**/test-files/**",
    "**/schemas/**",
    "**/static/**",
    "**/res/**",
    "**/pnpm-lock.yaml",
    "**/package-lock.json"
  ],
  "proseWrap": "preserve"
}
